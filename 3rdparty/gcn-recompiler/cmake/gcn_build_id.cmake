#
# Writes OUT (a header defining GCN_BUILD_ID) from the contents of the files listed in LIST
# (one path per line). The ID changes whenever any source that influences the translation
# output changes; persistent shader caches use it to drop entries of other builds.

file(STRINGS "${LIST}" inputs)
list(SORT inputs)
set(acc "")
foreach(f IN LISTS inputs)
    if (EXISTS "${f}")
        file(SHA256 "${f}" h)
        string(APPEND acc "${h}")
    endif()
endforeach()
string(SHA256 id "${acc}")
string(SUBSTRING "${id}" 0 32 id)
set(content "/* Generated by cmake/gcn_build_id.cmake - do not edit. */\n#define GCN_BUILD_ID \"${id}\"\n")
file(WRITE "${OUT}" "${content}")
